# Copy to .env.local for local development. On Hostinger, set these as
# environment variables for the Node.js app. Never commit real values.

# Contact form: mailbox that sends the notification (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
# 465 = SSL. If 465 is blocked, use 587 (STARTTLS).
SMTP_PORT=465
SMTP_USER=hello@upailabs.org
SMTP_PASS=

# Where contact form messages are delivered
CONTACT_TO=hello@upailabs.org
